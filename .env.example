# Backend API base URL. Leave unset to use platform defaults:
# iOS simulator / web -> http://localhost:3000
# Android emulator     -> http://10.0.2.2:3000  (localhost is not reachable from the emulator)
EXPO_PUBLIC_API_BASE_URL=

# Sentry crash/error reporting. Leave unset to disable entirely (local dev,
# CI, and any build before a real Sentry project exists) — Sentry.init is a
# no-op without a dsn.
EXPO_PUBLIC_SENTRY_DSN=

# Google Sign-In OAuth client IDs (not secrets — verified server-side against
# the ID token's `aud` claim). Both are required: omitting the iOS one throws
# "failed to determine clientID" at sign-in time on iOS specifically. Create
# them in Google Cloud Console — see backend's GOOGLE_OAUTH_WEB_CLIENT_ID /
# GOOGLE_OAUTH_IOS_CLIENT_ID, which must match these.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Stripe publishable key (pk_test_... / pk_live_...) — a PUBLIC client key, not
# a secret, safe to ship in the bundle. Leave unset to disable payment-method
# UI at runtime without crashing the app (StripeProvider mounts fine with an
# empty key; only the PaymentSheet call fails). Create it in the Stripe
# Dashboard — Developers → API keys. Must correspond to the same Stripe
# account as the backend's STRIPE_SECRET_KEY.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
